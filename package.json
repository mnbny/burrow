{
  "name": "@mnbny/burrow",
  "version": "0.1.0",
  "description": "Self-hosted static hosting with a deploy CLI",
  "homepage": "https://github.com/mnbny/burrow#readme",
  "bugs": {
    "url": "https://github.com/mnbny/burrow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnbny/burrow.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "burrow": "cli/burrow.bundle.mjs"
  },
  "files": [
    "cli/burrow.bundle.mjs"
  ],
  "scripts": {
    "build": "tsx .tools/scripts/build.ts",
    "prepack": "pnpm build",
    "pack:check": "pnpm build && tsx .tools/scripts/pack-check.ts",
    "release": "tsx .tools/scripts/release.ts",
    "test": "pnpm build && ./.tools/tests/e2e.sh",
    "validate": "pnpm validate:format && pnpm validate:lint && pnpm validate:typecheck && pnpm build",
    "validate:format": "prettier --write . --ignore-unknown --cache --log-level=error",
    "validate:lint": "eslint --fix --cache --format=pretty .",
    "validate:typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@fontsource-variable/archivo": "catalog:",
    "@fontsource-variable/space-grotesk": "catalog:",
    "@fontsource/space-mono": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "ansis": "catalog:",
    "change-case": "catalog:",
    "citty": "catalog:",
    "daisyui": "catalog:",
    "dompurify": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-formatter-pretty": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "marked": "catalog:",
    "marked-gfm-heading-id": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "semver": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "terser": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
